# Modelence dashboard environment. Copy to `.modelence.env` (gitignored), or generate it from
# autolab/.env with:  .venv/bin/python scripts/sync_dashboard_env.py
# Same Atlas database as the Python services, with the database name in the URI path.
MONGODB_URI=
# 3001 avoids the Atlas Agent Engine playground on 3000.
MODELENCE_PORT=3001
# Shared secret for POST /api/autolab/campaigns/* (header x-autolab-key). Any long random string.
AUTOLAB_API_KEY=
