# Local `agentengine dev up` reads this file (the container ignores host env vars).
# Copy to `.env` (gitignored) and fill in. For deploys, upload each with `agentengine secret set NAME`.
MONGODB_URI=
AUTOLAB_DB=so101_demo
ANTHROPIC_API_KEY=
# Optional locally (memory skips vector search without it); `agentengine atlas setup` can create one.
VOYAGE_API_KEY=
# Must be the same value in both agents. Any long random string.
A2A_JWT_SECRET=
RAINDROP_WRITE_KEY=
# Operator only: the local robot gateway exposed through an authenticated tunnel.
ROBOT_GATEWAY_URL=
ROBOT_GATEWAY_KEY=
