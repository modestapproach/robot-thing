# AutoLab environment template. Copy to `.env` and fill in the blanks:  cp .env.example .env
# `.env` is gitignored. Never commit real keys. Leave a value empty to use the default/offline behaviour.

# --- Database (MongoDB Atlas) -------------------------------------------------------------
# Atlas > Connect > Drivers > Python. Put the database name in the path, e.g. .../so101_demo?retryWrites=...
# Empty = run fully offline with an in-memory store (state saved to .autolab-state.pkl).
MONGODB_URI=
AUTOLAB_DB=so101_demo

# --- LLM (Scientist proposals) ------------------------------------------------------------
# Empty = deterministic cheapest-hypothesis-first policy instead of Claude.
ANTHROPIC_API_KEY=
AUTOLAB_SCIENTIST_MODEL=claude-opus-5-5

# --- Observability (Raindrop) -------------------------------------------------------------
# Empty = traces are only stored in the database (dashboard "Agent Traces" page).
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=

# --- Simulation world ---------------------------------------------------------------------
# so101 = MuJoCo physics twin of the SO-101 (default); mock = idealized mock arm.
AUTOLAB_WORLD=so101
# Optional path for offline state persistence (used when MONGODB_URI is empty).
AUTOLAB_STORE_FILE=

# --- Robot gateway (local service that owns the safety envelope) --------------------------
ROBOT_GATEWAY_URL=http://127.0.0.1:8081
ROBOT_GATEWAY_KEY=
# mock | so101_sim | so101 (real arm via LeRobot)
ROBOT_DRIVER=so101_sim
# Hard switch for real motion. Keep 0 until the workspace is clear.
ROBOT_PHYSICAL_ENABLE=0

# --- Real SO-101 arm (LeRobot) — only needed with ROBOT_DRIVER=so101 ----------------------
# Find the port with `lerobot-find-port`; calibrate with `lerobot-calibrate --robot.type=so101_follower ...`
SO101_PORT=
SO101_ID=autolab_follower
SO101_CALIBRATION_DIR=
SO101_MAX_STEP_DEG=8.0
# JSON per-joint convention fix found during bring-up, e.g. {"elbow_flex": {"sign": 1, "offset_deg": 0}}
SO101_JOINT_MAP=

# --- Simulation service (optional HTTP batch API) -----------------------------------------
SIM_SERVICE_URL=http://127.0.0.1:8082
SIM_SERVICE_KEY=

# --- Dashboard REST control (also set in dashboard/.modelence.env) -------------------------
AUTOLAB_API_KEY=
