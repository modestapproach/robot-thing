# Canonical experiment database (Modelence-provisioned Atlas preferred). Leave unset to use in-memory store.
MONGODB_URI=
AUTOLAB_DB=autolab
# Robot gateway
ROBOT_GATEWAY_URL=http://127.0.0.1:8081
ROBOT_GATEWAY_KEY=dev-gateway-key
ROBOT_DRIVER=mock            # mock | <real driver module once arm is identified>
ROBOT_PHYSICAL_ENABLE=0      # hard switch: 0 = never move real hardware
# Simulation service
SIM_SERVICE_URL=http://127.0.0.1:8082
SIM_SERVICE_KEY=dev-sim-key
# Observability
RAINDROP_WRITE_KEY=
# LLM
ANTHROPIC_API_KEY=
